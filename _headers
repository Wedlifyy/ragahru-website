# Response headers for Netlify and Cloudflare Pages (both read this file
# from the site root; GitHub Pages ignores it, harmlessly).

# Every page: basic hardening that costs nothing.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Fonts never change under the same name: keep them for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and previews: a week. Replacing a file under the same name shows
# within that week, or at once after a hard refresh.
/assets/*
  Cache-Control: public, max-age=604800
/templates/*
  Cache-Control: public, max-age=604800

# The page, styles, scripts and config are edited often and carry no
# version in their names, so they are checked again every hour.
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600
/config/*
  Cache-Control: public, max-age=3600
